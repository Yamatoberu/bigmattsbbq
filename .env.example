# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Square
SQUARE_ENV=sandbox
SQUARE_HOST=https://connect.squareupsandbox.com
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_FROZEN_CATEGORY_ID=
SQUARE_SAUCE_VARIATION_ID=

# Phase 5 — broadcast
# BROADCAST_SECRET gates the admin broadcast API. Rotate freely. Min 16 chars.
BROADCAST_SECRET=

# Phase 8 — Resend Contacts + Broadcasts
# RESEND_API_KEY must have full API access (not send-only). The Contacts and
# Broadcasts APIs require read/write permissions beyond what a send-only key provides.
#
# RESEND_AUDIENCE_ID: obtain from Resend dashboard -> Audiences.
# Required for POST /api/mailing-list. New subscribers are added to this audience
# with unsubscribed:false so they can receive broadcasts.
#
# RESEND_SEGMENT_ID: obtain from Resend dashboard -> Audiences -> Segments.
# Required for POST /api/admin/broadcast. Broadcasts are sent to this segment.
#
# Unsubscribes are handled natively by Resend via List-Unsubscribe header.
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID=

# Slack notifications
# SLACK_ORDERS_WEBHOOK_URL: Incoming Webhook URL for order notifications. Obtain from api.slack.com/apps.
# Optional — if not set, Slack notifications are silently skipped.
SLACK_ORDERS_WEBHOOK_URL=

# Phase 9 — SCA subdomain routing
# SCA_HOSTNAME is optional and defaults to sca.bigmattsbbq.com. Any hostname
# beginning with "sca." also routes to the SCA tracker.
SCA_HOSTNAME=
